programa {
  funcao inicio() {
     real valorHora, total
        inteiro horas
          escreva("Digite o valor da hora técnica: ")
        leia(valorHora)
        escreva("Digite a quantidade de horas trabalhadas: ")
        leia(horas)
         total = valorHora * horas
        escreva("O valor total a ser pago pelo serviço é: R$ ", total)

  }
}
