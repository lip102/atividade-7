programa {
  funcao inicio() {
    real largura, comprimento, area

        escreva("Digite a largura do galpão: ")
        leia(largura)

        escreva("Digite o comprimento do galpão: ")
        leia(comprimento)

        area = largura * comprimento

        escreva("A área total do galpão é: ", area, " m²")
        
  }
}
